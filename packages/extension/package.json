{
  "name": "@image-studio/extension",
  "version": "0.1.0",
  "private": true,
  "description": "VSCode extension for Image Studio",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "imageStudio.editor",
        "displayName": "Image Studio",
        "selector": [
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.jpg" },
          { "filenamePattern": "*.jpeg" },
          { "filenamePattern": "*.webp" },
          { "filenamePattern": "*.avif" }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "imageStudio",
          "title": "Image Studio",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "imageStudio": [
        {
          "id": "imageStudio.files",
          "name": "Images",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Image Studio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "imageStudio.files",
        "contents": "No images in this workspace.\n[Open Folder](command:vscode.openFolder)\nSupported formats: PNG, JPG, WebP, AVIF"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.view.extension.imageStudio",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\"
      }
    ],
    "configuration": {
      "title": "Image Studio",
      "properties": {
        "imageStudio.defaultCompareMode": {
          "type": "string",
          "enum": ["off", "slider", "preview"],
          "enumDescriptions": [
            "Show only the original image (clean view)",
            "Show before/after with a draggable reveal slider",
            "Show only the compressed preview"
          ],
          "default": "off",
          "description": "Default compare mode when opening a new image (user's last choice still overrides within a session)."
        },
        "imageStudio.defaultQuality": {
          "type": "number",
          "enum": [75, 85, 92],
          "enumDescriptions": ["Low — max size savings", "Medium — balanced", "High — near lossless"],
          "default": 85,
          "description": "Default quality for lossy formats."
        },
        "imageStudio.excludeFolders": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", ".git", "dist", "out", "build", ".next", ".vscode", ".idea"],
          "description": "Folder names skipped when listing images in the Activity Bar sidebar."
        }
      }
    }
  },
  "dependencies": {
    "@image-studio/core": "*",
    "sharp": "^0.33.4",
    "trash": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
