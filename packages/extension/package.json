{
  "name": "image-studio",
  "displayName": "Image Studio",
  "publisher": "adammery",
  "version": "0.3.0",
  "private": true,
  "description": "Image editor + AI converter for VSCode — crop, resize, compress PNG · JPG · WebP · AVIF with live preview, bulk converter, and MCP server for Claude Code, Cursor, and Claude Desktop.",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/adammery/image-studio" },
  "categories": ["Visualization", "Other"],
  "keywords": ["image", "png", "webp", "avif", "jpeg", "crop", "resize", "compress"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "node esbuild.config.mjs",
    "package": "vsce package --no-dependencies -o image-studio.vsix"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "imageStudio.editor",
        "displayName": "Image Studio",
        "selector": [
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.jpg" },
          { "filenamePattern": "*.jpeg" },
          { "filenamePattern": "*.webp" },
          { "filenamePattern": "*.avif" }
        ],
        "priority": "default"
      },
      {
        "viewType": "imageStudio.batchView",
        "displayName": "Image Studio — Batch Convert",
        "selector": [{ "filenamePattern": "image-studio-batch.batch" }],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "imageStudio",
          "title": "Image Studio",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "imageStudio": [
        {
          "id": "imageStudio.files",
          "name": "Images",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Image Studio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "imageStudio.files",
        "contents": "No images in this workspace.\n[Open Folder](command:vscode.openFolder)\nSupported formats: PNG, JPG, WebP, AVIF"
      }
    ],
    "commands": [
      {
        "command": "imageStudio.deleteImage",
        "title": "Move Image to Trash",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.openBatchView",
        "title": "Batch Convert…",
        "icon": "$(zap)",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.renameFile",
        "title": "Rename",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.deleteFile",
        "title": "Move to Trash",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.copyFile",
        "title": "Copy",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.cutFile",
        "title": "Cut",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.pasteFile",
        "title": "Paste",
        "category": "Image Studio"
      },
      {
        "command": "imageStudio.treeFileActivated",
        "title": "Open in Image Studio",
        "category": "Image Studio"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "imageStudio.openBatchView",
          "when": "view == imageStudio.files",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "imageStudio.treeFileActivated",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "imageStudio.copyFile",
          "when": "view == imageStudio.files && viewItem == imageFile",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "imageStudio.cutFile",
          "when": "view == imageStudio.files && viewItem == imageFile",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "imageStudio.pasteFile",
          "when": "view == imageStudio.files && (viewItem == imageFile || viewItem == imageFolder || viewItem == imageWorkspace)",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "imageStudio.renameFile",
          "when": "view == imageStudio.files && viewItem == imageFile",
          "group": "7_modification@1"
        },
        {
          "command": "imageStudio.deleteFile",
          "when": "view == imageStudio.files && viewItem == imageFile",
          "group": "7_modification@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.view.extension.imageStudio",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\"
      },
      {
        "command": "imageStudio.deleteImage",
        "key": "ctrl+delete",
        "mac": "cmd+backspace",
        "when": "activeCustomEditorId == 'imageStudio.editor'"
      },
      {
        "command": "imageStudio.renameFile",
        "key": "enter",
        "when": "focusedView == 'imageStudio.files' && listFocus && !inputFocus"
      },
      {
        "command": "imageStudio.renameFile",
        "key": "f2",
        "when": "focusedView == 'imageStudio.files' && listFocus && !inputFocus"
      },
      {
        "command": "imageStudio.deleteFile",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == 'imageStudio.files' && listFocus && !inputFocus"
      },
      {
        "command": "imageStudio.copyFile",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == 'imageStudio.files' && listFocus && !inputFocus"
      },
      {
        "command": "imageStudio.cutFile",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == 'imageStudio.files' && listFocus && !inputFocus"
      },
      {
        "command": "imageStudio.pasteFile",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == 'imageStudio.files' && listFocus && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Image Studio",
      "properties": {
        "imageStudio.defaultCompareMode": {
          "type": "string",
          "enum": ["off", "slider", "preview"],
          "enumDescriptions": [
            "Show only the original image (clean view)",
            "Show before/after with a draggable reveal slider",
            "Show only the compressed preview"
          ],
          "default": "off",
          "description": "Default compare mode when opening a new image (user's last choice still overrides within a session)."
        },
        "imageStudio.defaultQuality": {
          "type": "number",
          "enum": [75, 85, 92],
          "enumDescriptions": ["Low — max size savings", "Medium — balanced", "High — near lossless"],
          "default": 92,
          "description": "Default quality for lossy formats."
        },
        "imageStudio.excludeFolders": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", ".git", "dist", "out", "build", ".next", ".vscode", ".idea"],
          "description": "Folder names skipped when listing images in the Activity Bar sidebar."
        }
      }
    }
  },
  "dependencies": {
    "@image-studio/core": "*",
    "sharp": "^0.33.4",
    "trash": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.27.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
